# ─────────────────────────────────────────────────────────────
# SmartExpense Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file:  cp .env.example .env
# Then fill in real values before running docker-compose.
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────────

# Database
DB_NAME=smartexpense
DB_USER=smartexpense
DB_PASSWORD=CHANGE_ME                    # Generate with: openssl rand -base64 32

# Authentication
JWT_SECRET=CHANGE_ME                     # Generate with: openssl rand -base64 64

# Application
CORS_ORIGIN=http://localhost:8080        # Change to your server IP or domain in production
